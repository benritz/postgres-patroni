#!/usr/bin/env bash

set -euo pipefail
umask 077

CERT_NAME=$1

CERT_TARGET_DIR="${CERT_DIR:-/usr/local/etc/ssl}"

build_sans() {
  ALT_HOST_LINES=""
  ALT_IP_LINES=""
  HOSTS_CSV=""

  local dns_names=()
  local ip_addrs=()

  add_dns() {
    local n="$1"
    [ -z "$n" ] && return
    local e
    for e in "${dns_names[@]:-}"; do
      [ "$e" = "$n" ] && return
    done
    dns_names+=("$n")
  }

  add_ip() {
    local ip="$1"
    [ -z "$ip" ] && return
    local e
    for e in "${ip_addrs[@]:-}"; do
      [ "$e" = "$ip" ] && return
    done
    ip_addrs+=("$ip")
  }

  local short_host fqdn host_ips
  short_host="$(hostname -s 2>/dev/null || hostname 2>/dev/null || true)"
  [ -z "$short_host" ] && short_host="localhost"
  fqdn="$(hostname -f 2>/dev/null || true)"
  [ -z "$fqdn" ] && fqdn="$short_host"

  add_dns "${CERT_CN}"
  add_dns "$short_host"
  add_dns "$fqdn"
  add_dns "localhost"

  add_ip "127.0.0.1"
  add_ip "::1"

  # busybox does not support -I arg - hostname -I 2>/dev/null
  host_ipv4="$(ip -4 addr show 2>/dev/null | sed -n 's/.*inet \([0-9.]*\).*/\1/p' || true)"
  host_ipv6="$(ip -6 addr show 2>/dev/null | sed -n 's/.*inet6 \([^/]*\).*/\1/p' | grep -v '^fe80:' || true)"
  host_ips="${host_ipv4} ${host_ipv6}"

  local ip
  for ip in $host_ips; do
    if [ "$ip" != "127.0.0.1" ] && [ "$ip" != "::1" ]; then
      add_ip "$ip"
    fi
  done

  local i=1
  local n
  for n in "${dns_names[@]}"; do
    ALT_HOST_LINES+="DNS.$i = $n"$'\n'
    i=$((i + 1))
  done

  i=1
  for ip in "${ip_addrs[@]}"; do
    ALT_IP_LINES+="IP.$i = $ip"$'\n'
    i=$((i + 1))
  done

  # Build comma-separated list for cfssl -hostname
  local first=1
  for n in "${dns_names[@]}"; do
    if [ $first -eq 1 ]; then
      HOSTS_CSV="$n"
      first=0
    else HOSTS_CSV+=",$n"; fi
  done
  for ip in "${ip_addrs[@]}"; do
    if [ $first -eq 1 ]; then
      HOSTS_CSV="$ip"
      first=0
    else HOSTS_CSV+=",$ip"; fi
  done
}

# Allow overriding of subject fields via environment variables
: "${CERT_C:=US}"
: "${CERT_ST:=}"
: "${CERT_L:=}"
: "${CERT_O:=Test}"
: "${CERT_OU:=}"
: "${CERT_CN:=$(hostname -f 2>/dev/null || hostname)}"
: "${CERT_EXPIRY:=8760h}" # 1 year
: "${CERT_KEY_ALGO:=ecdsa}"
: "${CERT_KEY_SIZE:=256}"

build_sans

WORK_DIR="$(mktemp -d gen-ssl-XXXXXX)"
trap 'rm -rf "${WORK_DIR}"' EXIT

CSR_JSON="${WORK_DIR}/csr.json"
SIGNING_CONFIG_JSON="${WORK_DIR}/signing-config.json"

cat >"${CSR_JSON}" <<EOF
{
  "CN": "${CERT_CN}",
  "key": { "algo": "${CERT_KEY_ALGO}", "size": ${CERT_KEY_SIZE} },
  "names": [
    { "C": "${CERT_C}", "ST": "${CERT_ST}", "L": "${CERT_L}", "O": "${CERT_O}", "OU": "${CERT_OU}" }
  ]
}
EOF

cat >"${SIGNING_CONFIG_JSON}" <<EOF
{
  "signing": {
    "default": {
      "usages": ["digital signature", "key encipherment", "server auth", "client auth"],
      "expiry": "${CERT_EXPIRY}"
    }
  }
}
EOF

cfssl gencert \
  -ca "${CERT_TARGET_DIR}/ca-root.crt" -ca-key "${CERT_TARGET_DIR}/ca-root.key" \
  -config "${SIGNING_CONFIG_JSON}" \
  -hostname "${HOSTS_CSV}" \
  "${CSR_JSON}" | cfssljson -bare "${WORK_DIR}/${CERT_NAME}" >/dev/null

cp "${WORK_DIR}/${CERT_NAME}.pem" "${WORK_DIR}/${CERT_NAME}-combined.pem"
cat "${WORK_DIR}/${CERT_NAME}-key.pem" >>"${WORK_DIR}/${CERT_NAME}-combined.pem"

chmod 600 "${WORK_DIR}/${CERT_NAME}-key.pem" "${WORK_DIR}/${CERT_NAME}-combined.pem"
chmod 644 "${WORK_DIR}/${CERT_NAME}.pem"

install -m 600 "${WORK_DIR}/${CERT_NAME}-key.pem" "${CERT_TARGET_DIR}/${CERT_NAME}.key.tmp"
install -m 600 "${WORK_DIR}/${CERT_NAME}-combined.pem" "${CERT_TARGET_DIR}/${CERT_NAME}-combined.crt.tmp"
install -m 644 "${WORK_DIR}/${CERT_NAME}.pem" "${CERT_TARGET_DIR}/${CERT_NAME}.crt.tmp"

mv -f "${CERT_TARGET_DIR}/${CERT_NAME}.key.tmp" "${CERT_TARGET_DIR}/${CERT_NAME}.key"
mv -f "${CERT_TARGET_DIR}/${CERT_NAME}.crt.tmp" "${CERT_TARGET_DIR}/${CERT_NAME}.crt"
mv -f "${CERT_TARGET_DIR}/${CERT_NAME}-combined.crt.tmp" "${CERT_TARGET_DIR}/${CERT_NAME}-combined.crt"

chown -R ${CERT_USER}:${CERT_GROUP} "${CERT_TARGET_DIR}"
chmod 600 "${CERT_TARGET_DIR}/${CERT_NAME}.key" "${CERT_TARGET_DIR}/${CERT_NAME}-combined.crt"
chmod 644 "${CERT_TARGET_DIR}/${CERT_NAME}.crt"
