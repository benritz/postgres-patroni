#!/usr/bin/env bash

set -euo pipefail

source ./read-secret-var

read_secret_var CA_ROOT_CERT all
read_secret_var CA_ROOT_KEY all
export CERT_USER=etcd
export CERT_GROUP=etcd
gen-ssl
unset CA_ROOT_CERT CA_ROOT_KEY

export ETCD_NAME="${ETCD_NAME:=$HOSTNAME}"

export ETCD_DATA_DIR=/var/etcd-data
export ETCD_INITIAL_ADVERTISE_PEER_URLS=https://${HOSTNAME}:2380
export ETCD_ADVERTISE_CLIENT_URLS=https://${HOSTNAME}:2379
export ETCD_LISTEN_PEER_URLS=https://0.0.0.0:2380
export ETCD_LISTEN_CLIENT_URLS=https://0.0.0.0:2379

export ETCD_CERT_FILE=/usr/local/etc/ssl/server.crt
export ETCD_KEY_FILE=/usr/local/etc/ssl/server.key
export ETCD_CLIENT_CERT_AUTH=true
export ETCD_TRUSTED_CA_FILE=/usr/local/etc/ssl/ca-root.crt

export ETCD_PEER_CERT_FILE=/usr/local/etc/ssl/peer.crt
export ETCD_PEER_KEY_FILE=/usr/local/etc/ssl/peer.key
export ETCD_PEER_CLIENT_CERT_AUTH=true
export ETCD_PEER_TRUSTED_CA_FILE=/usr/local/etc/ssl/ca-root.crt

read_secret_var ETCD_INITIAL_CLUSTER_TOKEN

chown -R etcd:etcd /var/etcd-data/
chmod 0700 /var/etcd-data/
chown -R etcd:etcd /etc/etcd/

# try to add node to an existing cluster
if [[ "$ETCD_INITIAL_CLUSTER_STATE" == "existing" ]]; then
  echo "Adding to existing cluster"
  member_info=$(etcdctl --endpoints "$ETCD_ENDPOINTS" member list -w json | jq ".members[] | select(.peerURLs[]? == \"$ETCD_INITIAL_ADVERTISE_PEER_URLS\")")
  echo $member_info
  if [[ -z "$member_info" ]]; then
    echo "$ETCD_NAME is not a member, adding"
    MEMBER_ADD_OUT=$(mktemp)
    etcdctl --endpoints "$ETCD_ENDPOINTS" member add "$ETCD_NAME" --peer-urls="$ETCD_INITIAL_ADVERTISE_PEER_URLS" >"${MEMBER_ADD_OUT}" 2>&1 || true
    export ETCD_INITIAL_CLUSTER=$(grep 'ETCD_INITIAL_CLUSTER=' "${MEMBER_ADD_OUT}" | awk -F'"' '{print $2}')
    if [ -z "${ETCD_INITIAL_CLUSTER}" ]; then
      echo "Failed to add member $ETCD_NAME"
      echo "$MEMBER_ADD_OUT"
      rm "$MEMBER_ADD_OUT"
      exit 1
    fi
    rm "$MEMBER_ADD_OUT"
  else
    echo "$ETCD_NAME is already a member"
  fi
fi

# exec su-exec etcd etcd
exec etcd
