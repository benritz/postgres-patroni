#!/usr/bin/env bash

set -e

function read_secret_var() {
  local var="$1"
  local read_mode="${2:-line}"
  local file_var="${var}_FILE"
  local current_val="${!var:-}"
  local file_path="${!file_var:-}"
  local file_val
  if [[ -z "$current_val" && -n "$file_path" && -r "$file_path" ]]; then
    if [[ "$read_mode" == "all" ]]; then
      if IFS= read -r -d '' file_val <"$file_path" || true; then
        export "$var"="$file_val"
      fi
    else
      if IFS= read -r file_val <"$file_path" || true; then
        export "$var"="$file_val"
      fi
    fi
  fi
}

read_secret_var CA_ROOT_CERT all
read_secret_var CA_ROOT_KEY all
export CERT_USER=etcd
export CERT_GROUP=etcd
gen-ssl
unset CA_ROOT_CERT CA_ROOT_KEY

export ETCD_NAME="${ETCD_NAME:=$HOSTNAME}"

export ETCD_DATA_DIR=/var/etcd-data
export ETCD_INITIAL_ADVERTISE_PEER_URLS=https://${HOSTNAME}:2380
export ETCD_ADVERTISE_CLIENT_URLS=https://${HOSTNAME}:2379
export ETCD_LISTEN_PEER_URLS=https://0.0.0.0:2380
export ETCD_LISTEN_CLIENT_URLS=https://0.0.0.0:2379

export ETCD_CERT_FILE=/usr/local/etc/ssl/server.crt
export ETCD_KEY_FILE=/usr/local/etc/ssl/server.key
export ETCD_CLIENT_CERT_AUTH=true
export ETCD_TRUSTED_CA_FILE=/usr/local/etc/ssl/ca-root.crt

export ETCD_PEER_CERT_FILE=/usr/local/etc/ssl/peer.crt
export ETCD_PEER_KEY_FILE=/usr/local/etc/ssl/peer.key
export ETCD_PEER_CLIENT_CERT_AUTH=true
export ETCD_PEER_TRUSTED_CA_FILE=/usr/local/etc/ssl/ca-root.crt

read_secret_var ETCD_INITIAL_CLUSTER_TOKEN

etcd
