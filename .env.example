# Root environment variables for postgres-patroni
# Copy to .env and tweak as needed. docker compose reads this.

# ==== Certificate settings (used by etcd, patroni, haproxy) ====
# Subject details
CERT_C=US
CERT_ST=
CERT_L=
CERT_O=Test
CERT_OU=
# Common Name defaults to container hostname if unset
CERT_CN=
# Leaf cert expiry (cfssl duration); default 8760h = 1 year
CERT_EXPIRY=8760h
# Key algorithm: ecdsa or rsa
CERT_KEY_ALGO=ecdsa
# Key size: if ecdsa -> 256/384/521; if rsa -> 2048/3072/4096
CERT_KEY_SIZE=256

# ==== Cluster settings ====
# ETCD endpoints for postgres nodes
ETCD_HOSTS=etcd_01:2379,etcd_02:2379,etcd_03:2379
# Patroni cluster name
CLUSTER=

# ==== HAProxy ====
# Backend targets (pgbouncer ports)
TARGETS=pg_01:6432,pg_02:6432

# ==== Secrets file paths (mounted via Docker secrets) ====
CA_ROOT_CERT_FILE=/run/secrets/ca_root_cert
CA_ROOT_KEY_FILE=/run/secrets/ca_root_key
ETCD_INITIAL_CLUSTER_TOKEN_FILE=/run/secrets/etcd_initial_cluster_token
POSTGRES_SU_PWD_FILE=/run/secrets/postgres_su_password
POSTGRES_REPL_PWD_FILE=/run/secrets/postgres_repl_password
POSTGRES_REWIND_PWD_FILE=/run/secrets/postgres_rewind_password
PGBOUNCER_PWD_FILE=/run/secrets/pgbouncer_password

# ==== Backups / Restore ====
BACKUP_NAME=
BACKUP_REGION_FILE=/run/secrets/backup_region
BACKUP_PATH_FILE=/run/secrets/backup_path
BACKUP_ACCESS_KEY_FILE=/run/secrets/backup_access_key
BACKUP_SECRET_KEY_FILE=/run/secrets/backup_secret_key
RESTORE_NAME=
RESTORE_REGION_FILE=/run/secrets/restore_region
RESTORE_PATH_FILE=/run/secrets/restore_path
RESTORE_ACCESS_KEY_FILE=/run/secrets/restore_access_key
RESTORE_SECRET_KEY_FILE=/run/secrets/restore_secret_key
