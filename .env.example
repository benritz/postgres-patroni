# Certificate (used by etcd, patroni, postgres pgbouncer, haproxy)
# ca root (mandatory) gen-ca can generate a ca root cert+key
CA_ROOT_CERT=file:/run/secrets/ca_root_cert
# CA_ROOT_CERT=ssm:/certs/ca_root_cert
CA_ROOT_KEY=file:/run/secrets/ca_root_key
# CA_ROOT_KEY=ssm:/certs/ca_root_key

# Subject
CERT_C=US
CERT_ST=
CERT_L=
CERT_O=Test
CERT_OU=
# Common Name defaults to container hostname if unset
CERT_CN=
# cert expiry (cfssl duration); default 8760h = 1 year
CERT_EXPIRY=8760h
# Key algorithm: ecdsa or rsa
CERT_KEY_ALGO=ecdsa
# Key size: if ecdsa -> 256/384/521; if rsa -> 2048/3072/4096
CERT_KEY_SIZE=256

# Cluster 
CLUSTER=
ETCD_HOSTS=etcd_01:2379,etcd_02:2379,etcd_03:2379
# ETCD_INITIAL_CLUSTER_TOKEN supports prefixes: value:, file:, ssm:
#ETCD_INITIAL_CLUSTER_TOKEN=value:my-token
#ETCD_INITIAL_CLUSTER_TOKEN=file:/run/secrets/etcd_initial_cluster_token
#ETCD_INITIAL_CLUSTER_TOKEN=ssm:/prod/etcd/cluster-token

# HAProxy 
# Backend targets (pgbouncer 6432, postgres 5432)
TARGETS=pg_01:6432,pg_02:6432

# Postgres
POSTGRES_SU_USER=postgres
POSTGRES_SU_PWD=
POSTGRES_REPL_USER=replicator
POSTGRES_REPL_PWD=
POSTGRES_REWIND_USER=rewinder
POSTGRES_REWIND_PWD=
POSTGRES_SUBNET=
POSTGRES_ARCHIVE_TIMEOUT=
# Examples:
#POSTGRES_SU_PWD=value:supersecret
#POSTGRES_REPL_PWD=file:/run/secrets/postgres_repl_password
#POSTGRES_REWIND_PWD=ssm:/prod/db/postgres/rewind_password

# pgBackRest 
# BACKUP_NAME + RESTORE_NAME default to CLUSTER
BACKUP_NAME=
BACKUP_REGION=
BACKUP_PATH=
# do not include access + secret keys if using ec2 instance profile
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=
# Examples:
#BACKUP_PATH=value:s3://ibase-test-london/postgres-backup
#BACKUP_REGION=file:/run/secrets/backup_region
#BACKUP_ACCESS_KEY=ssm:/prod/db/postgres/backup_access_key
#BACKUP_SECRET_KEY=ssm:/prod/db/postgres/backup_secret_key

RESTORE_NAME=
RESTORE_REGION=
RESTORE_PATH=
# do not include access + secret keys if using ec2 instance profile
RESTORE_ACCESS_KEY=
RESTORE_SECRET_KEY=

# Logical dump to S3 (pg_dump -Fc)
# Only runs on Patroni leader; uses IAM role if keys omitted
DUMP_PATH=
DUMP_REGION=
# do not include access + secret keys if using ec2 instance profile
DUMP_ACCESS_KEY=
DUMP_SECRET_KEY=
# Compression level 0-9 (default 6)
DUMP_COMPRESSION=
# Cron schedule for automated dumps (e.g., 15 2 * * *)
DUMP_CRON=
