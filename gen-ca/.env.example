# gen-ca container environment variables
# Copy this file to ".env" and adjust values as needed.
# docker compose will read .env and pass these to the service.

# Common Name for the generated CA certificate
CERT_CN="Example Root CA"

# Key algorithm: ecdsa or rsa
CERT_KEY_ALGO=ecdsa

# Key size:
# - If ecdsa: 256, 384, or 521
# - If rsa: 2048, 3072, or 4096
CERT_KEY_SIZE=256

# Certificate expiry (cfssl duration format, e.g., 87600h = 10 years)
CERT_EXPIRY=87600h

# Subject details
CERT_C=US
CERT_ST=California
CERT_L="San Francisco"
CERT_O="Example Corp"
CERT_OU=Platform

# Optional: override where certs are written inside the container
# Default is /usr/local/etc/ssl and is volume-mapped to ./certs
# CERT_PATH=/usr/local/etc/ssl
