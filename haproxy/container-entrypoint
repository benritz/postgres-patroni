#!/usr/bin/env bash

set -euo pipefail

function read_secret_var() {
  local var="$1"
  local read_mode="${2:-line}"
  local value="${!var:-}"
  local resolved=""

  if [[ -n "$value" ]]; then
    if [[ "$value" == file:* ]]; then
      local path="${value#file:}"
      if [[ "$read_mode" == "all" ]]; then
        if [[ -r "$path" ]]; then
          resolved="$(cat -- "$path" 2>/dev/null || true)"
        fi
      else
        if [[ -r "$path" ]]; then
          IFS= read -r resolved <"$path" || true
        fi
      fi
    elif [[ "$value" == ssm:* ]]; then
      local param="${value#ssm:}"
      if command -v aws >/dev/null 2>&1; then
        resolved="$(aws ssm get-parameter --name "$param" --with-decryption --query 'Parameter.Value' --output text 2>/dev/null || true)"
      else
        echo "Warning: aws CLI not found; cannot fetch SSM param for $var" >&2
      fi
    elif [[ "$value" == value:* ]]; then
      resolved="${value#value:}"
    else
      resolved="$value"
    fi
    if [[ -n "$resolved" ]]; then
      export "$var"="$resolved"
    fi
  fi
}

read_secret_var CA_ROOT_CERT all
read_secret_var CA_ROOT_KEY all
export CERT_USER=haproxy
export CERT_GROUP=haproxy
gen-ssl
unset CA_ROOT_CERT CA_ROOT_KEY

: "${TARGETS?Error: TARGETS Missing}"

IFS=',' read -r -a HOST_ARRAY <<<"$TARGETS"

TARGETS=""
INDEX=1
for PART in "${HOST_ARRAY[@]}"; do
  TARGET_HOST="${PART// /}"
  if [[ -z "$TARGET_HOST" ]]; then
    continue
  fi
  TARGET_NAME="pg${INDEX}"
  LINE="    server ${TARGET_NAME} ${TARGET_HOST} maxconn 100 check check-ssl verify required port 8008 crt /usr/local/etc/ssl/client-combined.crt ca-file /usr/local/etc/ssl/ca-root.crt agent-check agent-port 8009"
  TARGETS+="${LINE}"$'\n'
  INDEX=$((INDEX + 1))
done

TARGETS="${TARGETS%$'\n'}"

awk -v block="$TARGETS" '
  /__TARGETS__/ { print block; next }
  { print }
' /usr/local/etc/haproxy/haproxy-template.cfg >/usr/local/etc/haproxy/haproxy.cfg

mkdir -p /var/run/haproxy
chown -R haproxy:haproxy /var/run/haproxy

exec su-exec haproxy haproxy -W -db -f /usr/local/etc/haproxy/haproxy.cfg
