#!/usr/bin/env bash

set -euo pipefail

source ./read-secret-var

read_secret_var CA_ROOT_CERT all
read_secret_var CA_ROOT_KEY all
export CERT_USER=haproxy
export CERT_GROUP=haproxy
gen-ssl
unset CA_ROOT_CERT CA_ROOT_KEY

: "${TARGETS?Error: TARGETS Missing}"

IFS=',' read -r -a HOST_ARRAY <<<"$TARGETS"

TARGETS=""
INDEX=1
for PART in "${HOST_ARRAY[@]}"; do
  TARGET_HOST="${PART// /}"
  if [[ -z "$TARGET_HOST" ]]; then
    continue
  fi
  TARGET_NAME="pg${INDEX}"
  LINE="    server ${TARGET_NAME} ${TARGET_HOST} maxconn 100 check check-ssl verify required port 8008 crt /usr/local/etc/ssl/client-combined.crt ca-file /usr/local/etc/ssl/ca-root.crt agent-check agent-port 8009"
  TARGETS+="${LINE}"$'\n'
  INDEX=$((INDEX + 1))
done

TARGETS="${TARGETS%$'\n'}"

awk -v block="$TARGETS" '
  /__TARGETS__/ { print block; next }
  { print }
' /usr/local/etc/haproxy/haproxy-template.cfg >/usr/local/etc/haproxy/haproxy.cfg

mkdir -p /var/run/haproxy
chown -R haproxy:haproxy /var/run/haproxy

exec su-exec haproxy haproxy -W -db -f /usr/local/etc/haproxy/haproxy.cfg
