#!/usr/bin/env bash

set -euo pipefail
umask 077

SSL_TARGET_DIR="${SSL_DIR:-/usr/local/etc/ssl}"
mkdir -p "${SSL_TARGET_DIR}"
chmod 750 "${SSL_TARGET_DIR}"

if [ -z "$CA_ROOT_CERT" ] || [ -z "$CA_ROOT_KEY" ]; then
  echo "Missing CA_ROOT_CERT/CA_ROOT_KEY vars"
  exit 1
fi

printf '%s' "$CA_ROOT_CERT" >"$SSL_TARGET_DIR/ca-root.crt"
printf '%s' "$CA_ROOT_KEY" >"$SSL_TARGET_DIR/ca-root.key"
chmod 644 "$SSL_TARGET_DIR/ca-root.crt"
chmod 600 "$SSL_TARGET_DIR/ca-root.key"

build_sans() {
  ALT_HOST_LINES=""
  ALT_IP_LINES=""
  HOSTS_CSV=""

  local dns_names=()
  local ip_addrs=()

  add_dns() {
    local n="$1"
    [ -z "$n" ] && return
    local e
    for e in "${dns_names[@]:-}"; do
      [ "$e" = "$n" ] && return
    done
    dns_names+=("$n")
  }

  add_ip() {
    local ip="$1"
    [ -z "$ip" ] && return
    local e
    for e in "${ip_addrs[@]:-}"; do
      [ "$e" = "$ip" ] && return
    done
    ip_addrs+=("$ip")
  }

  local short_host fqdn host_ips_raw
  short_host="$(hostname -s 2>/dev/null || hostname 2>/dev/null || true)"
  [ -z "$short_host" ] && short_host="localhost"
  fqdn="$(hostname -f 2>/dev/null || true)"
  [ -z "$fqdn" ] && fqdn="$short_host"

  add_dns "${SSL_CN}"
  add_dns "$short_host"
  add_dns "$fqdn"
  add_dns "localhost"

  add_ip "127.0.0.1"
  add_ip "::1"

  host_ips_raw="$(hostname -i 2>/dev/null || true)"
  local ip
  for ip in $host_ips_raw; do
    if [ "$ip" != "127.0.0.1" ] && [ "$ip" != "::1" ]; then
      add_ip "$ip"
    fi
  done

  local i=1
  local n
  for n in "${dns_names[@]}"; do
    ALT_HOST_LINES+="DNS.$i = $n"$'\n'
    i=$((i + 1))
  done

  i=1
  for ip in "${ip_addrs[@]}"; do
    ALT_IP_LINES+="IP.$i = $ip"$'\n'
    i=$((i + 1))
  done

  # Build comma-separated list for cfssl -hostname
  local first=1
  for n in "${dns_names[@]}"; do
    if [ $first -eq 1 ]; then
      HOSTS_CSV="$n"
      first=0
    else HOSTS_CSV+=",$n"; fi
  done
  for ip in "${ip_addrs[@]}"; do
    if [ $first -eq 1 ]; then
      HOSTS_CSV="$ip"
      first=0
    else HOSTS_CSV+=",$ip"; fi
  done
}

# Allow overriding of subject fields via environment variables
: "${SSL_C:=US}"
: "${SSL_ST:=State}"
: "${SSL_L:=Locality}"
: "${SSL_O:=Organization}"
: "${SSL_OU:=Unit}"
: "${SSL_CN:=$(hostname -f 2>/dev/null || hostname)}"
: "${SSL_DAYS:=365}"

build_sans

WORK_DIR="$(mktemp -d gen-ssl-XXXXXX)"
trap 'rm -rf "${WORK_DIR}"' EXIT

# Convert days to hours for cfssl expiry format
EXPIRY_HOURS=$((SSL_DAYS * 24))

CSR_JSON="${WORK_DIR}/server-csr.json"
SIGNING_CONFIG_JSON="${WORK_DIR}/signing-config.json"

cat >"${CSR_JSON}" <<EOF
{
  "CN": "${SSL_CN}",
  "key": { "algo": "ecdsa", "size": 256 },
  "names": [
    { "C": "${SSL_C}", "ST": "${SSL_ST}", "L": "${SSL_L}", "O": "${SSL_O}", "OU": "${SSL_OU}" }
  ]
}
EOF

cat >"${SIGNING_CONFIG_JSON}" <<EOF
{
  "signing": {
    "default": {
      "usages": ["digital signature", "key encipherment", "server auth", "client auth"],
      "expiry": "${EXPIRY_HOURS}h"
    }
  }
}
EOF

cfssl gencert \
  -ca "${SSL_TARGET_DIR}/ca-root.crt" -ca-key "${SSL_TARGET_DIR}/ca-root.key" \
  -config "${SIGNING_CONFIG_JSON}" \
  -hostname "${HOSTS_CSV}" \
  "${CSR_JSON}" | cfssljson -bare "${WORK_DIR}/client" >/dev/null

chmod 600 "${WORK_DIR}/client-key.pem"
chmod 644 "${WORK_DIR}/client.pem"

install -m 600 "${WORK_DIR}/client-key.pem" "${SSL_TARGET_DIR}/client.key.tmp"
install -m 644 "${WORK_DIR}/client.pem" "${SSL_TARGET_DIR}/client.crt.tmp"

mv -f "${SSL_TARGET_DIR}/client.key.tmp" "${SSL_TARGET_DIR}/client.key"
mv -f "${SSL_TARGET_DIR}/client.crt.tmp" "${SSL_TARGET_DIR}/client.crt"

chown -R haproxy:haproxy "${SSL_TARGET_DIR}"
chmod 600 "${SSL_TARGET_DIR}/client.key"
chmod 644 "${SSL_TARGET_DIR}/client.crt" "${SSL_TARGET_DIR}/ca-root.crt"

rm "$SSL_TARGET_DIR/ca-root.key"
